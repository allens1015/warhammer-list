// Copy of the rules published in the Firebase console (the console is what
// enforces them). Each signed-in user may read and write only their own area.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
